
@{
    
    ViewData["Title"] = "Login";
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~\css\style.css" rel="stylesheet" />
    <title>Login</title>
</head> 
<body>
    <!--  Body Wrapper -->
    <div class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" style="margin-left:210px; margin-top:-30px;">
        <div class="position-relative overflow-hidden radial-gradient min-vh-100 min-vw-100 d-flex align-items-center justify-content">
            <div class="d-flex align-items-center justify-content-center w-50">
                <div class="row justify-content-center w-100">
                    <div class="col-md-8 col-lg-6 col-xxl-3">
                        <div class="card mb-0">
                            <div class="card-body">
                                <p class="text-center fs-3">Login</p>
                                 <form method="post" asp-action="Login" asp-controller="home">
                                    <div class="mb-2">
                                        <label class="control-label" for="EmailId">Email</label>
                                        <input class="form-control" id="EmailId" name="EmailId" />
                                    </div> 
                                    <div class="mb-4">
                                        <label class="control-label" for="Password">Password</label>
                                        <input class="form-control" id="Password" name="Password" input type="password"/>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
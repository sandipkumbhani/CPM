
@{
    
    ViewData["Title"] = "Register";
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~\css\style.css" rel="stylesheet" />
    <title>Register</title>
</head> 
<body>
    <!--  Body Wrapper -->
    <div class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" style="margin-left:210px; margin-top:0px;">
        <div class="position-relative overflow-hidden radial-gradient min-vh-100 min-vw-100 d-flex align-items-center justify-content">
            <div class="d-flex align-items-center justify-content-center w-50">
                <div class="row justify-content-center w-100">
                    <div class="col-md-8 col-lg-8 col-xxl-3">
                        <div class="card mb-0">
                            <div class="card-body">
                                <p class="text-center fs-3">Register</p>
                                <form method="post" asp-action="Register" asp-controller="home">
                                    <div class="mb-2">
                                        <label for="ClinicName" class="control-label">Clinic Name</label>
                                        <input class="form-control" id="ClinicName" name="ClinicName" />
                                    </div>
                                    <div class="mb-3">
                                        <label for="DoctorName" class="control-label">Doctor Name</label>
                                        <input class="form-control" id="DoctorName" name="DoctorName" />
                                    </div>
                                    <div class="mb-2">
                                        <select class="form-select" aria-label="Default select example" id="SkillId" name="SkillId">
                                            <option selected>Skill</option>
                                            <option value="4">Psychiatrist</option>
                                            <option value="5">Orthopaedist</option>
                                            <option value="6">Neurologist</option>
                                        </select>
                                    </div> 
                                    <div class="mb-2">
                                        <label class="control-label" for="Email">Email</label>
                                        <input  class="form-control" / id="Email" name="Email">
                                    </div>
                                    <div class="mb-2">
                                        <label class="control-label" for="PhoneNumber">Phone No.</label>
                                        <input class="form-control" id="PhoneNumber" name="PhoneNumber" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="control-label" for="Address">Address</label>
                                        <input class="form-control" id="Address" name="Address" />
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">Save</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>